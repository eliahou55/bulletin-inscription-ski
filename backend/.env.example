# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Email d'envoi (doit être un email @votre-domaine vérifié dans Resend)
FROM_EMAIL=noreply@loisirel.online

# Email de l'organisateur (reçoit les notifications de nouvelles inscriptions)
ORGANIZER_EMAIL=loisirel@hotmail.fr

# Port (Render le définit automatiquement)
PORT=3000
